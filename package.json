{
  "name": "ti4",
  "private": true,
  "type": "module",
  "workspaces": [
    "shared",
    "client",
    "dev"
  ],
  "scripts": {
    "dev": "npm run dev -w dev",
    "build": "npm run build -w shared -w client",
    "start": "npm run start -w dev",
    "typecheck": "tsc -p shared && tsc -p client && tsc -p dev",
    "release": "ahob-release"
  },
  "devDependencies": {
    "@joeyanglx/ahob-build": "^0.1.0",
    "concurrently": "^10.0.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
